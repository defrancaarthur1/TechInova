Script SQL de criação das tabelas

CREATE DATABASE IF NOT EXISTS sistema_compras;
USE sistema_compras;

-- =========================================
-- TABELA: FORNECEDOR
-- =========================================
CREATE TABLE fornecedor (
idFornecedor INT AUTO_INCREMENT PRIMARY KEY,
nomeFornecedor VARCHAR(100) NOT NULL,
cnpjFornecedor VARCHAR(18) NOT NULL UNIQUE,
telefoneFornecedor VARCHAR(12) NOT NULL,
emailFornecedor VARCHAR(100),
categoriaProduto VARCHAR(50),
enderecoFornecedor VARCHAR(200),
dataCadastro DATE NOT NULL,
consultorVenda VARCHAR(100),
telefoneConsultor VARCHAR(12),
produtosFornecedor VARCHAR(100)
);

-- =========================================
-- TABELA: CATEGORIA
-- =========================================
CREATE TABLE categoria (
idCategoria INT AUTO_INCREMENT PRIMARY KEY,
nomeCategoria VARCHAR(100) NOT NULL UNIQUE
);

-- =========================================
-- TABELA: PRODUTO
-- =========================================
CREATE TABLE produto (
idProduto INT AUTO_INCREMENT PRIMARY KEY,
nomeProduto VARCHAR(100) NOT NULL,
categoriaProduto VARCHAR(50) NOT NULL,
preco DECIMAL(10,2) NOT NULL,
quantidade INT NOT NULL,
dataCadastro DATE NOT NULL,
idFornecedor INT NOT NULL,
CONSTRAINT fk_produto_fornecedor
FOREIGN KEY (idFornecedor)
REFERENCES fornecedor(idFornecedor)
ON UPDATE CASCADE
ON DELETE RESTRICT,
CONSTRAINT fk_produto_categoria
FOREIGN KEY (categoriaProduto)
REFERENCES categoria(nomeCategoria)
ON UPDATE CASCADE
ON DELETE RESTRICT,


CONSTRAINT chk_preco_produto
CHECK (preco >= 0),
CONSTRAINT chk_quantidade_produto
CHECK (quantidade >= 0)
);

-- =========================================
-- TABELA: COMPRA
-- =========================================
CREATE TABLE compra (
idCompra INT AUTO_INCREMENT PRIMARY KEY,
dataCompra DATE NOT NULL,
categoriaProduto VARCHAR(50) NOT NULL,
nomeProduto VARCHAR(100) NOT NULL,
valorTotal DECIMAL(10,2) NOT NULL,
quantidade INT NOT NULL,
idFornecedor INT NOT NULL,
CONSTRAINT fk_compra_fornecedor
FOREIGN KEY (idFornecedor)
REFERENCES fornecedor(idFornecedor)
ON UPDATE CASCADE
ON DELETE RESTRICT,
CONSTRAINT fk_compra_categoria
FOREIGN KEY (categoriaProduto)
REFERENCES categoria(nomeCategoria)
ON UPDATE CASCADE
ON DELETE RESTRICT,
CONSTRAINT chk_valor_total_compra
CHECK (valorTotal >= 0),
CONSTRAINT chk_quantidade_compra
CHECK (quantidade > 0)
);

-- =========================================
-- TABELA: ITEMCOMPRA
-- =========================================
CREATE TABLE itemCompra (
idCompra INT NOT NULL,
idProduto INT NOT NULL,
nomeProduto VARCHAR(100) NOT NULL,
quantidade INT NOT NULL,
valorTotal DECIMAL(10,2) NOT NULL,
dataCompra DATE NOT NULL,
PRIMARY KEY (idCompra, idProduto),
CONSTRAINT fk_itemcompra_compra
FOREIGN KEY (idCompra)
REFERENCES compra(idCompra)
ON UPDATE CASCADE
ON DELETE CASCADE,
CONSTRAINT fk_itemcompra_produto
FOREIGN KEY (idProduto)
REFERENCES produto(idProduto)
ON UPDATE CASCADE
ON DELETE RESTRICT,
CONSTRAINT chk_quantidade_itemcompra
CHECK (quantidade > 0),
CONSTRAINT chk_valor_total_itemcompra
CHECK (valorTotal >= 0)
);

